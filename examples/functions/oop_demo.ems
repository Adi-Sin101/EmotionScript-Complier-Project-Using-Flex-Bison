mind OopDemo
awake

persona Human <<
    open interpret greet(words msg) yields truth <<
        speak("Human says: " + msg);
        reflect yes;
    >>
>>

persona Teacher evolves_from Human <<
    reshape open interpret greet(words msg) yields truth <<
        speak("Teacher says: " + msg);
        reflect yes;
    >>
>>

Teacher t1;
invoke t1.greet("Hello from class!");
speak("OOP demo complete");

sleep;
