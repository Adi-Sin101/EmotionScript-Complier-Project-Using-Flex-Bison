mind FlowDemo
awake
count i;
truth gate;
set i -> 0;
set gate -> yes;
if_feel gate == yes
    speak("if branch");
else_if_feel i > 3
    speak("else-if branch");
else_feel
    speak("else branch");
end_feel
ruminate i < 3
    set i -> i + 1;
    if_feel i == 2
        continue_flow;
    end_feel
    speak(i);
end_ruminate
replay (set i -> 0; i < 5; i++)
    if_feel i == 3
        break_free;
    end_feel
    speak(i);
end_ruminate
sleep
